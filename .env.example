# Copy this file to .env.local (for local dev) and set the same values
# in your Vercel project's Environment Variables (for deployment).
# Never commit the real .env.local file.

# --- Database (Neon Postgres, free tier: neon.tech) ---
# Create a project at neon.tech, copy the "pooled connection string".
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Auth ---
# A long random string used to sign admin session tokens.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# --- ImageKit: Profile Pic / DP category (imagekit.io, free tier: 5GB) ---
IMAGEKIT_PROFILE_PUBLIC_KEY=
IMAGEKIT_PROFILE_PRIVATE_KEY=
IMAGEKIT_PROFILE_URL_ENDPOINT=https://ik.imagekit.io/your_id_1

# --- ImageKit: Anime Wallpaper category (separate free-tier account) ---
IMAGEKIT_ANIME_PUBLIC_KEY=
IMAGEKIT_ANIME_PRIVATE_KEY=
IMAGEKIT_ANIME_URL_ENDPOINT=https://ik.imagekit.io/your_id_2

# --- ImageKit: Natural Wallpaper category (separate free-tier account) ---
IMAGEKIT_NATURAL_PUBLIC_KEY=
IMAGEKIT_NATURAL_PRIVATE_KEY=
IMAGEKIT_NATURAL_URL_ENDPOINT=https://ik.imagekit.io/your_id_3

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# --- Ads (optional, leave empty until you have an approved provider) ---
# Setting this alone does NOT show ads — see lib/ads.ts for how to wire
# a real provider in. Leaving it empty means downloads work with no ad step.
NEXT_PUBLIC_AD_PROVIDER=
